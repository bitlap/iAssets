# 本文件记录 Flutter 项目属性，供 Flutter 工具判断项目能力及执行升级。
#
# 本文件应纳入版本控制，其配置值由 Flutter 工具维护，不应手动修改。

version:
  revision: "ad70ec4617166f1c38e5d2bfd388af71fda14f06"
  channel: "stable"

project_type: app

# 记录 flutter migrate 命令使用的迁移元数据。
migration:
  platforms:
    - platform: root
      create_revision: ad70ec4617166f1c38e5d2bfd388af71fda14f06
      base_revision: ad70ec4617166f1c38e5d2bfd388af71fda14f06
    - platform: ios
      create_revision: ad70ec4617166f1c38e5d2bfd388af71fda14f06
      base_revision: ad70ec4617166f1c38e5d2bfd388af71fda14f06

  # 用户自定义配置

  # 迁移工具应忽略的本地路径，相对于本文件所在目录。
  #
  # 不属于项目模板的文件默认会被忽略。
  unmanaged_files:
    - 'lib/main.dart'
    - 'ios/Runner.xcodeproj/project.pbxproj'
