# iOS 签名配置（含 Apple Developer Team ID，不上传）
/ios/Config.xcconfig

# App Store 隐私政策（独立 git 仓库，不上传主仓库）
/iAssets-privacy/

# 杂项临时文件
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ 开发工具配置
*.iml
*.ipr
*.iws
.idea/

# .vscode 中的启动配置和任务可能需要纳入版本控制，默认不忽略该目录。
#.vscode/

# Flutter、Dart 和 Pub 生成文件
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# 符号化文件
app.*.symbols

# 混淆映射文件
app.*.map.json

# Android Studio 构建产物
/android/app/debug
/android/app/profile
/android/app/release

# 本机 App Store Connect 发布凭证
/scripts/release_ios.env
*.p8
