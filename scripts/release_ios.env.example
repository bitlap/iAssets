# Copy to release_ios.env (gitignored), fill in the values, then run:
# ./scripts/release_ios.sh
# The script loads release_ios.env automatically; caller environment takes priority.
# Use an App Store Connect team API key with permission to upload this app.
ASC_KEY_PATH="/absolute/path/outside/repository/AuthKey_YOUR_KEY_ID.p8"
ASC_KEY_ID="YOUR_KEY_ID"
ASC_ISSUER_ID="00000000-0000-0000-0000-000000000000"
# Optional if ios/Config.xcconfig already contains DEVELOPMENT_TEAM:
# APPLE_TEAM_ID="YOURTEAMID"
# BUILD_NAME="1.6.0"
# BUILD_NUMBER="1.6.1"
