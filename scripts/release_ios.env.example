# 复制为 release_ios.env（已加入忽略列表），填写配置后运行：
# ./scripts/release_ios.sh
# 脚本会自动加载 release_ios.env，调用方提供的环境变量优先。
# 使用具有此应用上传权限的 App Store Connect 团队 API 密钥。
ASC_KEY_PATH="/absolute/path/outside/repository/AuthKey_YOUR_KEY_ID.p8"
ASC_KEY_ID="YOUR_KEY_ID"
ASC_ISSUER_ID="00000000-0000-0000-0000-000000000000"
# 包含 AssetsWidget 的构建需同时指定主应用和组件的 App Store 描述文件，
# 两份描述文件均须包含 group.org.bitlap.assets 应用组权限。
# IOS_APP_PROFILE_NAME="iAssets App Store Widgets 2026"
# IOS_WIDGET_PROFILE_NAME="iAssets Widget App Store 2026"
# 首次启用付费机制的上线分界固定为北京时间 2026-11-10 00:00。
# 后续所有版本均须保持此值不变。
PRO_LEGACY_CUTOFF="2026-11-09T16:00:00Z"
# 购买页面展示的隐私政策网址，须可公开访问并持续维护。
PRO_PRIVACY_URL="https://bitlap.org/iAssets-privacy/"
# 若 ios/Config.xcconfig 已配置 DEVELOPMENT_TEAM，下列团队标识可省略：
# APPLE_TEAM_ID="YOURTEAMID"
# BUILD_NAME="2.0.0"
# BUILD_NUMBER="1"
